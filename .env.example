# Everything is optional for local development, but payments need the Khalti key.

# Khalti sandbox secret key: sign up at https://test-admin.khalti.com
KHALTI_API_SECRET_KEY=
# Set to True only when using your live Khalti key
KHALTI_LIVE=False

# Leave empty to print receipt emails in the terminal instead of sending them.
# (Gmail: use an App Password.)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Production only
# SECRET_KEY=change-me
# DEBUG=False
# ALLOWED_HOSTS=example.com,www.example.com
